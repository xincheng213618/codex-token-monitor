<Window x:Class="CodexTokenMonitor.PriceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="价格设置" Width="1220" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="价格设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="为每个用量来源配置 10 个展示位置，按供应商选择模型。" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
            </StackPanel>
            <Button x:Name="ModelPricesButton" Grid.Column="1" Content="模型价格 →" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="ModelPricesButton_Click" />
        </Grid>
        <TabControl x:Name="SourceTabs" Grid.Row="1" Height="38" Margin="0,0,0,12" HorizontalAlignment="Left"
                    Style="{StaticResource SourceTabsStyle}" ItemContainerStyle="{StaticResource SourceTabItemStyle}"
                    SelectionChanged="SourceTabs_SelectionChanged" />
        <Border x:Name="PriceEditor" Grid.Row="2" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GroupDescription" Text="展示位置" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="按位置顺序展示 · 可留空" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <DataGrid x:Name="SlotGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="48"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位置" Binding="{Binding PositionLabel}" Width="80" />
                        <DataGridTemplateColumn Header="供应商" Width="175">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="4" VerticalAlignment="Center" ToolTip="选择此位置的供应商" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="模型" Width="300">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="ChoiceLabel"
                                          SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="4" VerticalAlignment="Center" ToolTip="{Binding PriceSource}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="输入 / 缓存输入 / 缓存创建 / 输出" Binding="{Binding PriceSummary}" Width="*" MinWidth="265" />
                        <DataGridTemplateColumn Header="调整" Width="120">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="↑" Padding="7,4" Click="MoveUpButton_Click" ToolTip="上移" />
                                    <Button Content="↓" Padding="7,4" Margin="4,0,0,0" Click="MoveDownButton_Click" ToolTip="下移" />
                                    <Button Content="清空" Style="{StaticResource StatusLinkButton}" Margin="4,0,0,0" Click="ClearSlotButton_Click" />
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource DialogFooter}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock x:Name="StatusText" Text="正在读取价格设置…" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                    <TextBlock Text="模型单价在“模型价格”页面编辑；修改在保存设置后生效。" Style="{StaticResource SectionDescription}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RetryLoadButton" Content="重新读取" Style="{StaticResource StatusLinkButton}" Click="RetryLoadButton_Click" Margin="0,0,12,0" />
                    <Button x:Name="RestoreButton" Content="恢复当前来源默认" Style="{StaticResource StatusLinkButton}" Click="RestoreButton_Click" Margin="0,0,12,0" />
                    <Button Content="取消" MinWidth="72" IsCancel="True" />
                    <Button x:Name="SaveButton" Content="保存设置" MinWidth="88" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
