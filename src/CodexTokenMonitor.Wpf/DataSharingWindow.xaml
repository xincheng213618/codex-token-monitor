<Window x:Class="CodexTokenMonitor.DataSharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="局域网共享 · Codex 数据同步"
        Width="810" Height="830" MinWidth="650" MinHeight="630"
        WindowStartupLocation="CenterOwner" Background="#F6F8FB"
        FontFamily="Microsoft YaHei UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#26364A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6E0EA" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6E0EA" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE5ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="跨电脑同步 Codex 数据" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,16" TextWrapping="Wrap" Foreground="#65758A"
                       Text="只合并同一个 Codex 账户的数据。第一次等两台电脑缓存完成后，点‘同步全部历史’；以后日常同步最近 8 天即可。重复同步不会重复计数。" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="本机作为服务器" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServerStateText" Text="未开启" Foreground="#65758A" HorizontalAlignment="Right" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="监听端口" VerticalAlignment="Center" />
                        <TextBox x:Name="PortBox" Grid.Column="1" Text="36666" Width="100" HorizontalAlignment="Left" MaxLength="5" />
                        <Button x:Name="ServerToggleButton" Grid.Column="2" Content="开启服务" Click="ServerToggleButton_Click" />
                        <TextBlock Grid.Row="1" Text="访问密钥" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBox x:Name="LocalKeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,10,10,0" />
                        <Button Grid.Row="1" Grid.Column="2" Content="复制密钥" Margin="0,10,0,0" Click="CopyKeyButton_Click" />
                        <TextBlock Grid.Row="2" Text="连接地址" VerticalAlignment="Top" Margin="0,16,0,0" />
                        <TextBox x:Name="LocalAddressesBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="52"
                                 Text="开启服务后显示可供其他电脑连接的地址" />
                    </Grid>
                    <CheckBox x:Name="AutoStartBox" Content="启动程序时自动开启共享服务" Margin="0,12,0,0" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#65758A" FontSize="12"
                               Text="开启后，本机接受上传与下载。关闭此窗口仍保持服务；退出程序即停止。数据同步由按钮手动执行。" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#65758A" FontSize="12"
                               Text="连接不上时，请在 Windows 防火墙中允许此程序访问专用网络。HTTP 传输适用于可信局域网或 VPN。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="连接另一台服务器" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="服务器地址" VerticalAlignment="Center" />
                        <TextBox x:Name="RemoteAddressBox" Grid.Column="1" ToolTip="例如 192.168.1.10:36666" />
                        <TextBlock Grid.Row="1" Text="访问密钥" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBox x:Name="RemoteKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" MaxLength="128" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="TestButton" Content="测试连接" Click="TestButton_Click" Margin="0,0,10,6" />
                        <Button x:Name="HistorySyncButton" Content="同步全部历史" Click="HistorySyncButton_Click" Margin="0,0,10,6" />
                        <Button x:Name="SyncButton" Content="双向同步最近 8 天" Click="SyncButton_Click" Margin="0,0,10,6" />
                        <Button x:Name="UploadButton" Content="上传最近 8 天" Click="UploadButton_Click" Margin="0,0,10,6" />
                        <Button x:Name="DownloadButton" Content="下载并合并最近 8 天" Click="DownloadButton_Click" Margin="0,0,10,6" />
                        <Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="CancelButton_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#65758A" FontSize="12"
                               Text="全部历史：分批上传本机已缓存记录，再下载并合并服务器记录，最后刷新最近用量。日常最近 8 天：覆盖当前 7d 额度窗口。长期离线或补录旧数据后，可再次同步全部历史；套餐与价格设置在各自电脑管理。" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="OperationText" Text="就绪。选择开启本机服务，或填写另一台服务器的地址。" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="最近活动" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="ActivityBox" IsReadOnly="True" Height="95" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Window>
