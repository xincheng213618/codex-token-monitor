<UserControl x:Class="CodexTokenMonitor.QuotaForecastPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="RefreshForecastButton" DockPanel.Dock="Right" Content="刷新数据" Style="{StaticResource ToolButton}"
                        Padding="9,0" MinWidth="0" Height="28" Click="RefreshForecastButton_Click" />
                <TextBlock Text="用量预测" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel>
                <StackPanel Width="136" Margin="0,0,7,8">
                    <TextBlock Text="参考消耗区间" Style="{StaticResource SectionDescription}" Margin="0,0,0,4" />
                    <ComboBox x:Name="LookbackBox" SelectedIndex="1" SelectionChanged="ForecastInput_Changed">
                        <ComboBoxItem Content="最近 15 分钟" /><ComboBoxItem Content="最近 1 小时" />
                        <ComboBoxItem Content="最近 3 小时" /><ComboBoxItem Content="本周期" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Width="136" Margin="0,0,0,8">
                    <TextBlock Text="未来工作量" Style="{StaticResource SectionDescription}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ActivityBox" SelectedIndex="0" SelectionChanged="ForecastInput_Changed"
                              ToolTip="相对于参考区间的每小时 Token 工作量；参考区间已包含空闲。">
                        <ComboBoxItem Content="保持当前" /><ComboBoxItem Content="降至 75%" />
                        <ComboBoxItem Content="降至 50%" /><ComboBoxItem Content="降至 25%" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="LookbackNoticeText" Foreground="{StaticResource AccentBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="目标时间（北京时间）" Style="{StaticResource SectionDescription}" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetBox" Grid.Column="1" Width="104" SelectedIndex="0" SelectionChanged="TargetBox_SelectionChanged">
                    <ComboBoxItem Content="账号重置" /><ComboBoxItem Content="手动预计" />
                </ComboBox>
            </Grid>
            <TextBlock x:Name="AccountResetText" Style="{StaticResource SectionDescription}" Margin="0,0,0,8" />
            <xctk:DateTimePicker x:Name="TargetPicker" Format="Custom" FormatString="yyyy-MM-dd HH:mm"
                                 TimeFormat="Custom" TimeFormatString="HH:mm" Height="32" Margin="0,0,0,8"
                                 Visibility="Collapsed" ValueChanged="TargetPicker_ValueChanged"
                                 ToolTip="只改变预测目标，不修改账号重置时间或使用重置卡。"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
            <ComboBox x:Name="ScenarioBox" DisplayMemberPath="Label" SelectionChanged="ScenarioBox_SelectionChanged"
                      Margin="0,0,0,8" ToolTip="选择方案，将预测叠加到左侧时间线上。" />
            <Expander x:Name="ComparisonExpander" Header="比较模型与 Fast" IsExpanded="False" Margin="0,0,0,7">
                <DataGrid x:Name="ScenarioGrid" Style="{StaticResource BaseDataGrid}" Margin="0,7,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionChanged="ScenarioGrid_SelectionChanged" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="方案" Binding="{Binding Label}" Width="118" />
                        <DataGridTextColumn Header="预计用尽" Binding="{Binding Runout}" Width="100" SortMemberPath="Scenario.RunoutAtLocal" />
                        <DataGridTextColumn Header="目标剩余" Binding="{Binding Remaining}" Width="70" SortMemberPath="Scenario.RemainingAtResetPercent" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="ForecastCaptionText" Text="预计用尽" Style="{StaticResource SectionDescription}" />
                    <TextBlock x:Name="ForecastValueText" Text="等待数据" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,3"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ForecastStatusText" Text="按近期工作量推算" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ForecastBasisText" Style="{StaticResource SectionDescription}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock x:Name="BudgetHintText" Foreground="{StaticResource AccentBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock Style="{StaticResource SectionDescription}" Text="虚线为假设预测。换模型 / Fast 按相同 Token 工作量比较；实际任务、缓存和并发变化会影响结果。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
