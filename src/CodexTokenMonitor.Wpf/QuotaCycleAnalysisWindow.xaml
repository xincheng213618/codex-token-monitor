<Window x:Class="CodexTokenMonitor.QuotaCycleAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTokenMonitor"
        Title="周期模型与额度代价"
        Width="1480"
        Height="990"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16,13" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource QuotaValue}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,5,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="MetricNote" TargetType="TextBlock" BasedOn="{StaticResource QuotaDetail}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,13">
            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" Text="模型日志 × 额度快照插值" />
            </Border>
            <StackPanel>
                <TextBlock x:Name="CycleTitleText" Style="{StaticResource PageTitle}" TextWrapping="Wrap" Margin="0,0,16,0" />
                <TextBlock x:Name="CycleMetaText" Margin="0,5,16,0" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="AnalysisScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <Grid Height="{Binding ViewportHeight, ElementName=AnalysisScrollViewer}" MinHeight="780">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="400" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="140" />
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabel}" Text="可归因额度跌幅" />
                    <TextBlock x:Name="QuotaDropValue" Style="{StaticResource MetricValue}" Text="-" />
                    <TextBlock x:Name="QuotaDropNote" Style="{StaticResource MetricNote}" Text="等待额度锚点" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabel}" Text="这段换算代价（含 Fast）" />
                    <TextBlock x:Name="EquivalentCostValue" Style="{StaticResource MetricValue}" Text="-" />
                    <TextBlock x:Name="EquivalentCostNote" Style="{StaticResource MetricNote}" Text="订阅额度比较口径" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabel}" Text="全周期 100% 折算" />
                    <TextBlock x:Name="FullEstimateValue" Style="{StaticResource MetricValue}" Text="-" />
                    <TextBlock x:Name="FullEstimateNote" Style="{StaticResource MetricNote}" Text="按全部可归因区间加权" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabel}" Text="5% 分段波动" />
                    <TextBlock x:Name="VolatilityValue" Style="{StaticResource MetricValue}" Text="-" />
                    <TextBlock x:Name="VolatilityNote" Style="{StaticResource MetricNote}" Text="局部折算离散程度" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabel}" Text="主导模型" />
                    <TextBlock x:Name="DominantModelValue" Style="{StaticResource MetricValue}" Text="-" FontFamily="Microsoft YaHei UI" FontSize="21" />
                    <TextBlock x:Name="DominantModelNote" Style="{StaticResource MetricNote}" Text="按归因额度跌幅" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="6,2,6,6">
                        <TabControl x:Name="ChartViewTabs" Style="{StaticResource SourceTabsStyle}" HorizontalAlignment="Left"
                                    SelectedIndex="0" SelectionChanged="ChartViewTabs_SelectionChanged">
                            <TabItem Header="换算代价" /><TabItem Header="消耗时间线" />
                        </TabControl>
                        <TextBlock x:Name="ChartDescriptionText" Style="{StaticResource SectionDescription}" Margin="0,5,0,0"
                                   Text="额度位置 × 局部换算代价 · 上方色带为主导模型 · 点击联动下方明细" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="ChartHost" />
                        <local:QuotaConsumptionTimelineView x:Name="ConsumptionTimelineView" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ModelCompositionPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="模型构成" />
                        <TextBlock Style="{StaticResource SectionDescription}" Margin="0,4,0,0" Text="额度归因占比" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ModelShareList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,10" ToolTip="{Binding Detail}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Margin="0,0,8,0">
                                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Share}" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding ShareValue}"
                                                     Foreground="{Binding Accent}" Background="{StaticResource BorderBrush}" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{StaticResource SubtleBrush}" CornerRadius="5" Padding="10" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionDescription}" Text="本周期最明显的差异" />
                            <TextBlock x:Name="InsightText" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="ForecastCard" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Visibility="Collapsed">
                <local:QuotaForecastPanel x:Name="ForecastPanel" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,0,2,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="分段明细" />
                <TextBlock x:Name="BandDescriptionText" Style="{StaticResource SectionDescription}" Margin="0,4,0,0"
                           Text="每行按 5% 额度带聚合；小于 2% 的边缘区间标为小样本" />
            </StackPanel>
            <Border x:Name="ModelCapacityBadge" Grid.Row="1" Margin="0,7,0,0" Background="#FFF7ED"
                    BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="7" Padding="10,6"
                    ToolTipService.ShowDuration="12000">
                <TextBlock x:Name="ModelCapacityValue" Foreground="#9A4D00" FontSize="11"
                           FontWeight="SemiBold" Text="样本不足" TextWrapping="Wrap" LineHeight="18" />
            </Border>
        </Grid>

        <DataGrid x:Name="BandGrid" Grid.Row="3" SelectionChanged="BandGrid_SelectionChanged"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="剩余额度" Binding="{Binding QuotaRange}" Width="116" />
                <DataGridTextColumn x:Name="TimeRangeColumn" Header="发生时间" Binding="{Binding TimeRange}" Width="220" />
                <DataGridTextColumn x:Name="ConsumptionTimeColumn" Header="消耗时段（北京时间）" Binding="{Binding ConsumptionTimeRange}" SortMemberPath="ConsumptionStart" Width="260" Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ConsumptionDurationColumn" Header="经过时间" Binding="{Binding ConsumptionDuration}" SortMemberPath="ConsumptionElapsed" Width="140" Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ConsumptionRateColumn" Header="消耗速度（百分点/小时）" Binding="{Binding ConsumptionRate}" SortMemberPath="ConsumptionRateValue" Width="180" ElementStyle="{StaticResource NumericCellText}" Visibility="Collapsed" />
                <DataGridTextColumn Header="主导模型" Binding="{Binding DominantModel}" Width="112" />
                <DataGridTextColumn Header="模型混用" Binding="{Binding ModelMix}" Width="220" />
                <DataGridTextColumn Header="掉了" Binding="{Binding QuotaDrop}" Width="78" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens}" Width="92" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="本段代价" Binding="{Binding EquivalentCost}" Width="96" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="换算 100%" Binding="{Binding FullEstimate}" Width="104" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="拟合 100%" Binding="{Binding FittedEstimate}" Width="104" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="偏离拟合" Binding="{Binding FitDifference}" Width="88" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="相对均值" Binding="{Binding Difference}" Width="88" ElementStyle="{StaticResource NumericCellText}" />
                <DataGridTextColumn Header="可信度" Binding="{Binding Reliability}" Width="78" />
            </DataGrid.Columns>
        </DataGrid>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5" />
                <TextBlock Style="{StaticResource SectionDescription}"
                       Text="说明：模型与 Token 来自会话日志；额度位置会在服务端快照之间插值。分段归因适合比较模型代价和波动，不等同于官方逐请求计费。" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Content="关闭" Click="CloseButton_Click" VerticalAlignment="Bottom" />
          </Grid>
        </Border>
    </Grid>
</Window>
