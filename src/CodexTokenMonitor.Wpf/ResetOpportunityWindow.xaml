<Window x:Class="CodexTokenMonitor.ResetOpportunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="重置机会设置" Width="980" Height="650" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="重置机会" Style="{StaticResource PageTitle}" />
            <TextBlock Text="管理重置卡的有效期与使用状态。时间均为北京时间。"
                       Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="可用重置卡" Style="{StaticResource SectionDescription}" />
                    <TextBlock x:Name="AvailableCountText" Text="—" FontFamily="Segoe UI" FontSize="22"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Text="最近到期" Style="{StaticResource SectionDescription}" />
                    <TextBlock x:Name="ExpirySummaryText" Text="暂无" FontSize="16" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <TextBlock Text="记录概览" Style="{StaticResource SectionDescription}" />
                    <TextBlock x:Name="ResetRecordCountText" Text="0 条记录" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14">
            <Grid x:Name="ResetEditor">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="重置记录" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增今天" Style="{StaticResource ToolButton}" Click="AddTodayButton_Click" Margin="0,0,8,0" />
                        <Button Content="从 Codex 同步" Style="{StaticResource ToolButton}" Click="SyncButton_Click" Margin="0,0,8,0"
                                ToolTip="从 Codex 账户读取重置卡并立即保存到本机；取消窗口不会撤销同步结果。" />
                        <Button x:Name="DeleteResetButton" Content="删除所选" Style="{StaticResource ToolButton}" Click="DeleteButton_Click" Margin="0,0,8,0" />
                        <Button Content="恢复示例" Style="{StaticResource ToolButton}" Click="DefaultsButton_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="从 Codex 同步会立即保存；手动编辑、新增与删除在点击保存后生效。"
                           Style="{StaticResource SectionDescription}" Margin="0,0,0,12" />
                <Grid Grid.Row="2">
                    <DataGrid x:Name="ResetGrid" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="True" CanUserDeleteRows="True" CanUserSortColumns="True"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              RowHeight="36" MinRowHeight="36" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="获得时间" Binding="{Binding GrantedText, UpdateSourceTrigger=LostFocus}" Width="180" />
                            <DataGridTextColumn Header="过期时间" Binding="{Binding ExpiresText, UpdateSourceTrigger=LostFocus}" Width="180" />
                            <DataGridCheckBoxColumn Header="已使用" Binding="{Binding IsUsed, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="ResetEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False" Margin="16,54,16,12">
                        <TextBlock Text="还没有重置记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="点击“新增今天”手动记录，或从 Codex 同步。" Style="{StaticResource SectionDescription}"
                                   Margin="0,6,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Text="双击编辑 · Delete 删除 · 过期时间留空时按获得时间 + 30 天计算"
                           Style="{StaticResource SectionDescription}" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DialogFooter}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource ToolButton}" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
