<Window x:Class="CodexTokenMonitor.QuotaEstimateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Codex 额度估算" Width="1360" Height="940" MinWidth="980" MinHeight="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="EstimateCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="EstimateDetail" TargetType="TextBlock" BasedOn="{StaticResource SectionDescription}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="EstimateValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,2,0,5" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="CycleActionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=WeeklyGrid}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NumericColumn" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="164" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="274" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="额度估算" Style="{StaticResource PageTitle}" />
                <TextBlock Text="查看当前余量、费用折算与历史周期。估算来自本机记录，所有时间均为北京时间。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource EstimateCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="5h 剩余额度" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="FiveHourPlan" Grid.Column="1" Style="{StaticResource EstimateDetail}" TextAlignment="Right" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="FiveHourValue" Grid.Row="1" Text="--" Style="{StaticResource EstimateValue}" />
                    <TextBlock x:Name="FiveHourDetail" Grid.Row="2" Text="正在读取额度信息…" Style="{StaticResource EstimateDetail}" />
                    <TextBlock x:Name="FiveHourStable" Grid.Row="3" Style="{StaticResource EstimateDetail}" TextWrapping="NoWrap" Margin="0,6,0,0" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource EstimateCard}" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="7d 剩余额度" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="WeekPlan" Grid.Column="1" Style="{StaticResource EstimateDetail}" TextAlignment="Right" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="WeekValue" Grid.Row="1" Text="--" Style="{StaticResource EstimateValue}" />
                    <TextBlock x:Name="WeekDetail" Grid.Row="2" Text="正在读取额度信息…" Style="{StaticResource EstimateDetail}" />
                    <TextBlock x:Name="WeekStable" Grid.Row="3" Style="{StaticResource EstimateDetail}" TextWrapping="NoWrap" Margin="0,6,0,0" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource EstimateCard}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ResetOpportunityPanel" /></ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource EstimateCard}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="手动估算 7d" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="剩余从" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <xctk:DecimalUpDown x:Name="ManualFromBox" Width="66" Height="32" Minimum="0" Maximum="100" Increment="1" Value="90" FormatString="F0" TextAlignment="Right" Margin="0,0,4,0" ShowButtonSpinner="False" />
                    <TextBlock Text="%  →" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <xctk:DecimalUpDown x:Name="ManualToBox" Width="66" Height="32" Minimum="0" Maximum="100" Increment="1" Value="85" FormatString="F0" TextAlignment="Right" Margin="0,0,4,0" ShowButtonSpinner="False" />
                    <TextBlock Text="%" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="ManualEstimateButton" Style="{StaticResource PrimaryButton}" Content="开始估算" Click="ManualEstimateButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="ManualResultText" Grid.Row="1" Text="输入前后剩余百分比，估算当前周额度的费用规模。" Style="{StaticResource SectionDescription}" Margin="0,7,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="14,0,14,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="历史 7d 周期" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="HistoryCountText" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="打开额度曲线" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="QuotaCurveButton_Click" />
                        <Button Content="分析所选周期" Style="{StaticResource CycleActionButton}" Click="AnalyzeCycleMenuItem_Click" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="WeeklyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" FrozenColumnCount="1" SelectionMode="Single"
                          PreviewMouseRightButtonDown="WeeklyGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="分析此周期的模型与额度代价" Click="AnalyzeCycleMenuItem_Click" /></ContextMenu></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="周期" Binding="{Binding Period}" Width="224" />
                        <DataGridTextColumn Header="历时" Binding="{Binding Duration}" Width="100" />
                        <DataGridTextColumn Header="重置" Binding="{Binding ResetAt}" Width="96" />
                        <DataGridTextColumn Header="快照" Binding="{Binding SnapshotCount}" Width="62" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="剩余" Binding="{Binding Remaining}" Width="66" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="已用" Binding="{Binding UsedPercent}" Width="62" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="应%" Binding="{Binding ExpectedPercent}" Width="62" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="节奏" Binding="{Binding Rhythm}" Width="116" />
                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens}" Width="104" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="订阅折算 $（含 Fast）" Binding="{Binding UsedCost}" Width="168"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumn}"><Setter Property="ToolTip" Value="{Binding CostDetail}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="已识别 Fast" Binding="{Binding FastCount}" Width="94"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumn}"><Setter Property="ToolTip" Value="{Binding CostDetail}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="订阅折算 100% $" Binding="{Binding EstimatedLimit}" Width="138" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="套餐" Binding="{Binding PlanNames}" Width="96" />
                        <DataGridTextColumn Header="实际 ¥" Binding="{Binding PlanAmount}" Width="84" ElementStyle="{StaticResource NumericColumn}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,38,16,10" TextBlock.TextAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=WeeklyGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock x:Name="HistoryEmptyText" Text="正在读取历史周期…" Style="{StaticResource SectionDescription}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource DialogFooter}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="正在加载估算…" Style="{StaticResource SectionDescription}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="关闭" MinWidth="80" Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
