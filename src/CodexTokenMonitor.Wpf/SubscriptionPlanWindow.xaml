<Window x:Class="CodexTokenMonitor.SubscriptionPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        x:ClassModifier="internal"
        Title="套餐设置" Width="980" Height="650" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="订阅套餐" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按购买记录计算订阅成本。时间均为北京时间。"
                           Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14,8" MaxWidth="280">
                <StackPanel>
                    <TextBlock x:Name="CurrentPlanText" Text="暂无生效套餐" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentPlanDetailText" Text="可在下方添加购买记录" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="MonthlyEditor" Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="续订 / 新增" Style="{StaticResource SectionTitle}" />
                    <TextBlock Grid.Column="1" Text="默认沿用上次套餐与月费" Style="{StaticResource SectionDescription}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="开始时间" Style="{StaticResource SectionDescription}" Margin="0,0,0,5" />
                        <xctk:DateTimePicker x:Name="MonthStartPicker" Format="Custom" FormatString="yyyy-MM-dd HH:mm"
                                             Height="34" TimeFormat="Custom" TimeFormatString="HH:mm"
                                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="套餐" Style="{StaticResource SectionDescription}" Margin="0,0,0,5" />
                        <ComboBox x:Name="MonthlyPlanBox" IsEditable="True" Height="34" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="月费（¥）" Style="{StaticResource SectionDescription}" Margin="0,0,0,5" />
                        <TextBox x:Name="MonthlyAmountBox" Height="34" HorizontalContentAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="添加一个月" Style="{StaticResource ToolButton}"
                            VerticalAlignment="Bottom" Click="AddMonthlyButton_Click" />
                </Grid>
                <TextBlock x:Name="AccountStatusText" Text="正在读取 Codex 账户套餐…" Style="{StaticResource SectionDescription}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="PlansEditor" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="购买记录" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="PlanRecordCountText" Text="0 条" Style="{StaticResource SectionDescription}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="从 Codex 导入" Style="{StaticResource ToolButton}" Click="ImportButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="DeletePlanButton" Content="删除所选" Style="{StaticResource ToolButton}" Click="DeleteButton_Click" Margin="0,0,8,0" />
                        <Button Content="恢复示例" Style="{StaticResource ToolButton}" Click="DefaultsButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="PlansGrid" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="True" CanUserDeleteRows="True" SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" RowHeight="36" MinRowHeight="36" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="开始时间" Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="180" />
                            <DataGridTextColumn Header="结束时间" Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="180" />
                            <DataGridTextColumn Header="套餐" Binding="{Binding PlanName, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="金额（¥）" Binding="{Binding AmountText, UpdateSourceTrigger=LostFocus}" Width="120"
                                                ElementStyle="{StaticResource NumericCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="PlansEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False" Margin="16,50,16,10">
                        <TextBlock Text="还没有购买记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="在上方添加一个月，或从 Codex 导入记录。" Style="{StaticResource SectionDescription}"
                                   Margin="0,6,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="双击编辑 · Delete 删除 · 结束时间留空时按一个自然月计算"
                           Style="{StaticResource SectionDescription}" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DialogFooter}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="修改和导入记录在保存后生效。" Style="{StaticResource PageSubtitle}"
                           VerticalAlignment="Center" Margin="0,0,18,0" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RetryLoadButton" Content="重新读取" Style="{StaticResource ToolButton}" Click="RetryLoadButton_Click" Margin="0,0,8,0" />
                    <Button Content="取消" IsCancel="True" Style="{StaticResource ToolButton}" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
