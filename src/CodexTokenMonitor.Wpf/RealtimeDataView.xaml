<UserControl x:Class="CodexTokenMonitor.RealtimeDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontWeight="Normal" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="244" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <UniformGrid x:Name="MetricStrip" Columns="5" Margin="0,0,0,6">
            <StackPanel><TextBlock Text="实时并行速度" Style="{StaticResource QuotaCaption}" /><TextBlock x:Name="LiveValue" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></StackPanel>
            <StackPanel><TextBlock Text="最近响应" Style="{StaticResource QuotaCaption}" /><TextBlock x:Name="LastValue" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            <StackPanel><TextBlock Text="今日平均输出" Style="{StaticResource QuotaCaption}" /><TextBlock x:Name="AverageValue" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            <StackPanel><TextBlock Text="今日实测峰值" Style="{StaticResource QuotaCaption}" /><TextBlock x:Name="PeakValue" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            <StackPanel><TextBlock Text="有效 / 请求" Style="{StaticResource QuotaCaption}" /><TextBlock x:Name="CoverageValue" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
        </UniformGrid>
        <ContentControl x:Name="ChartHost" Grid.Row="1" />
        <TextBlock x:Name="SampleStatus" Grid.Row="2" Margin="0,3,0,0" Text="等待采样 · 今日 UTC+8" Style="{StaticResource SectionDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Border x:Name="RecentSessionsPanel" Grid.Column="1" Grid.RowSpan="3" Margin="12,0,0,0" Padding="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="近期会话" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ListBox x:Name="SessionList" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Session}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" ToolTip="{Binding Session}" />
                                <TextBlock Grid.Column="1" Text="{Binding Live}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Row="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" Margin="0,3,6,0" Foreground="{StaticResource MutedBrush}" FontSize="11" ToolTip="{Binding Model}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Phase}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
