<Window x:Class="CodexTokenMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTokenMonitor"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="{Binding WindowTitle}" Width="1380" Height="940" MinWidth="1060" MinHeight="800"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="MainWindow_PreviewDragOver" PreviewDrop="MainWindow_PreviewDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="UsageVisibility" />
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="HeaderToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="HeaderSourceTab" TargetType="TabItem" BasedOn="{StaticResource SourceTabItemStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="DetailsTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource HeaderSourceTab}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailsTabsStyle" TargetType="TabControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel LastChildFill="True" Margin="0">
                                <TextBlock x:Name="CostEstimateCaption" DockPanel.Dock="Right" Text="费用为 API 等价估算" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" Visibility="Collapsed" />
                                <TabPanel IsItemsHost="True" Margin="0" />
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="0"><Setter TargetName="CostEstimateCaption" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="0" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="210" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="CompactHeader" Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TabControl x:Name="SourceTabs" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource SourceTabsStyle}" ItemContainerStyle="{StaticResource HeaderSourceTab}" SelectionChanged="SourceTabs_SelectionChanged" />
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DataTransferButton" Style="{StaticResource HeaderToolButton}" Content="数据管理" Click="DataTransferButton_Click" ToolTip="导入、导出或共享 Codex 数据；也可拖入数据包">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="导入其他电脑数据..." ToolTip="仅合并同一 Codex 账户的数据" Click="ImportDataButton_Click" />
                            <MenuItem Header="导出当前明细 CSV..." Click="ExportCurrentCsvButton_Click" />
                            <Separator />
                            <MenuItem Header="仅导出今天数据..." Click="ExportTodayDataButton_Click" />
                            <MenuItem Header="仅导出本周数据..." Click="ExportThisWeekDataButton_Click" />
                            <MenuItem Header="导出全部数据..." Click="ExportDataButton_Click" />
                            <Separator /><MenuItem Header="局域网共享..." Click="DataSharingButton_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="SpeedAnalysisButton" Style="{StaticResource HeaderToolButton}" Content="速度分析" Click="SpeedAnalysisButton_Click" ToolTip="查看实时速度、模型和会话明细；历史与导出在分析窗口内" />
                <Button x:Name="ResetSettingsButton" Style="{StaticResource HeaderToolButton}" Content="重置设置" Click="ResetSettingsButton_Click" />
                <Button x:Name="PlanSettingsButton" Style="{StaticResource HeaderToolButton}" Content="套餐设置" Click="PlanSettingsButton_Click" />
                <Button Style="{StaticResource HeaderToolButton}" Content="价格设置" Click="PriceSettingsButton_Click" />
                <Button x:Name="CheckForUpdatesButton" Style="{StaticResource HeaderToolButton}" Margin="0" Content="检查更新" Click="CheckForUpdatesButton_Click" ToolTip="检查 GitHub Releases 上的最新正式版本" />
            </StackPanel>
        </Grid>
        <Border x:Name="QuotaPanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16,9" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width=".9*" />
                    <ColumnDefinition Width="1.25*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="5h 剩余额度" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="Quota5hValue" Text="--" Style="{StaticResource QuotaValue}" />
                    <TextBlock x:Name="Quota5hDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="7d 剩余额度" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="QuotaWeekValue" Text="--" Style="{StaticResource QuotaValue}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="QuotaWeekDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="当前套餐" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="PlanSpendValue" Text="-" Style="{StaticResource QuotaValue}" />
                    <TextBlock x:Name="PlanSpendDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="重置卡到期" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ResetOpportunityValue" Text="-" Style="{StaticResource QuotaValue}" FontSize="17" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="ResetOpportunityDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel x:Name="ReserveUsagePanel" Grid.Column="4" Margin="0,0,16,0" Visibility="Collapsed">
                    <TextBlock Text="Reserve 已用" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ReserveUsageValue" Text="-" Style="{StaticResource QuotaValue}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="ReserveUsageDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,16,0">
                    <TextBlock Text="重置评估" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ResetPaceValue" Text="-" Style="{StaticResource QuotaValue}" />
                    <TextBlock x:Name="ResetPaceDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <Button x:Name="QuotaEstimateButton"
                        Grid.Column="6"
                        Style="{StaticResource PrimaryButton}"
                        Content="额度估算"
                        ToolTip="查看当前窗口、手动区间和历史周期；可继续分析所选周期"
                        VerticalAlignment="Center"
                        Click="QuotaEstimateButton_Click" />
            </Grid>
        </Border>
        <Border x:Name="ZCodeQuotaPanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16,9" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="剩余余额" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ZCodeQuotaRemainingValue" Text="--" Style="{StaticResource QuotaValue}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="ZCodeQuotaRemainingDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="已用余额" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ZCodeQuotaUsedValue" Text="--" Style="{StaticResource QuotaValue}" />
                    <TextBlock x:Name="ZCodeQuotaUsedDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="当前套餐" Style="{StaticResource QuotaCaption}" />
                    <ComboBox x:Name="ZCodeQuotaPlanBox" MinWidth="180" MaxWidth="280" Margin="0,2,0,3" HorizontalAlignment="Left" SelectionChanged="ZCodeQuotaPlanBox_SelectionChanged" />
                    <TextBlock x:Name="ZCodeQuotaPlanDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="到期时间" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ZCodeQuotaExpiryValue" Text="-" Style="{StaticResource QuotaValue}" FontSize="17" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="ZCodeQuotaExpiryDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,16,0">
                    <TextBlock Text="重置卡" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="ZCodeResetCreditValue" Text="-" Style="{StaticResource QuotaValue}" FontSize="17" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="ZCodeResetCreditDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <Button x:Name="ZCodeQuotaAnalysisButton" Style="{StaticResource ToolbarButton}" Content="消费分析" Click="ZCodeQuotaAnalysisButton_Click" ToolTip="查看套餐期内消费时间线、分段速度与用尽预测" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="DshBalancePanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16,9" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="充值余额" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="DshBalanceValue" Text="--" Style="{StaticResource QuotaValue}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="DshBalanceDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="赠金余额" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="DshBonusValue" Text="--" Style="{StaticResource QuotaValue}" />
                    <TextBlock x:Name="DshBonusDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="账号（dsh 登录）" Style="{StaticResource QuotaCaption}" />
                    <TextBlock x:Name="DshAccountValue" Text="-" Style="{StaticResource QuotaValue}" FontSize="17" />
                    <TextBlock x:Name="DshAccountDetail" Style="{StaticResource QuotaDetail}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button x:Name="DshBalanceRefreshButton" Style="{StaticResource ToolbarButton}" Content="刷新余额" Click="DshBalanceRefreshButton_Click" ToolTip="立即从 DeepSeek 平台重新读取账号余额" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12,6" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="统计范围" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="RangeModeBox" Width="108" Margin="0,2,8,2" SelectionChanged="RangeModeBox_SelectionChanged" />
                <StackPanel x:Name="DayTimeZonePanel" Orientation="Horizontal" ToolTip="仅按天统计生效；按所选时区的零点划分一天，其他统计范围保持不变">
                    <TextBlock Text="时区" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0" />
                    <ComboBox x:Name="DayTimeZoneBox" Width="116" Margin="0,2,8,2" SelectionChanged="DayTimeZoneBox_SelectionChanged" />
                </StackPanel>
                <Button x:Name="PreviousButton" Style="{StaticResource ToolbarButton}" Width="34" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" ToolTip="上一时段" Click="PreviousButton_Click" />
                <DatePicker x:Name="DatePicker" Width="146" Margin="0,2,8,2" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                <xctk:DateTimePicker x:Name="WeekEndPicker" Width="188" Format="Custom" FormatString="yyyy-MM-dd HH:mm" Margin="0,2,8,2" Visibility="Collapsed" ValueChanged="WeekEndPicker_ValueChanged" />
                <ComboBox x:Name="CycleBox" Width="310" Margin="0,2,8,2" Visibility="Collapsed" SelectionChanged="CycleBox_SelectionChanged">
                    <ComboBox.ContextMenu><ContextMenu><MenuItem Header="分析所选周期的模型与额度代价" Click="AnalyzeSelectedCycleMenuItem_Click" /></ContextMenu></ComboBox.ContextMenu>
                </ComboBox>
                <Button x:Name="WeekPickerButton" Style="{StaticResource ToolbarButton}" Content="选7天" Visibility="Collapsed" Click="WeekPickerButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource ToolbarButton}" Width="34" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" ToolTip="下一时段" Click="NextButton_Click" />
                <Button x:Name="CurrentButton" Style="{StaticResource ToolbarButton}" MinWidth="68" Content="今天" Click="CurrentButton_Click" />
                <Button x:Name="StartNowButton" Style="{StaticResource ToolbarButton}" Content="从当前算" Click="StartNowButton_Click" />
                <Button x:Name="RefreshDayButton" Style="{StaticResource ToolbarButton}" Content="刷新日" Click="RefreshDayButton_Click" />
                <xctk:DateTimePicker x:Name="CustomStartPicker" Width="210" Margin="0,2" Format="Custom" FormatString="yyyy-MM-dd HH:mm:ss" Visibility="Collapsed" ValueChanged="CustomStartPicker_ValueChanged" />
            </WrapPanel>
        </Border>
        <Border x:Name="UsageSummaryPanel" Visibility="{Binding ShowContent, Converter={StaticResource UsageVisibility}}" Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="18,10" MinHeight="112" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="总用量 · TOKENS" Style="{StaticResource MetricCaption}" />
                    <TextBlock x:Name="TotalValue" Text="{Binding Snapshot.Total}" FontFamily="Segoe UI" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2" />
                    <TextBlock x:Name="PeriodValue" Text="{Binding Snapshot.Period}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="CostCardsViewport" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" ClipToBounds="True" Focusable="False" SizeChanged="CostCardsViewport_SizeChanged">
                    <StackPanel x:Name="CostCardsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="UsageMetricsPanel" Visibility="{Binding ShowContent, Converter={StaticResource UsageVisibility}}" Grid.Row="5" Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <UniformGrid Columns="9" Rows="1">
                <Border Style="{StaticResource MetricTile}" ToolTip="Input · 包含缓存读取和缓存写入的总输入"><StackPanel><TextBlock Text="输入" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="InputValue" Text="{Binding Snapshot.Input}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Cached · 缓存命中的输入"><StackPanel><TextBlock Text="缓存读取" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="CachedValue" Text="{Binding Snapshot.Cached}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Cache Write · 创建缓存的输入"><StackPanel><TextBlock Text="缓存写入" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="CacheWriteValue" Text="{Binding Snapshot.CacheWrite}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Uncached · 未命中缓存的输入"><StackPanel><TextBlock Text="未缓存" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="UncachedValue" Text="{Binding Snapshot.Uncached}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Output · 输出 Token"><StackPanel><TextBlock Text="输出" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="OutputValue" Text="{Binding Snapshot.Output}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Reasoning · 推理输出 Token"><StackPanel><TextBlock Text="推理" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="ReasoningValue" Text="{Binding Snapshot.Reasoning}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Cache Ratio · 缓存读取占总输入的比例"><StackPanel><TextBlock Text="缓存命中" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="CacheRatioValue" Text="{Binding Snapshot.CacheRatio}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="Events · 用量事件数"><StackPanel><TextBlock Text="事件数" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="EventsValue" Text="{Binding Snapshot.Events}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
                <Border Style="{StaticResource MetricTile}" BorderThickness="0" ToolTip="Coding Time · 以 10 分钟空闲间隔计算的活跃时长"><StackPanel><TextBlock Text="活跃时长" Style="{StaticResource MetricCaption}" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="CodingTimeValue" Text="{Binding Snapshot.CodingTime}" Style="{StaticResource MetricValue}" /></Viewbox></StackPanel></Border>
            </UniformGrid>
        </Border>
        <Grid x:Name="UsageDetailsPanel" Grid.Row="6" Visibility="{Binding ShowContent, Converter={StaticResource UsageVisibility}}" TextElement.FontWeight="Normal">
            <Grid.RowDefinitions><RowDefinition x:Name="TimelineRow" Height="0" /><RowDefinition x:Name="TimelineSplitterRow" Height="0" /><RowDefinition x:Name="BreakdownRow" Height="*" MinHeight="112" /></Grid.RowDefinitions>
            <Border x:Name="UsageTrendPanel" Grid.Row="0" Visibility="{Binding Visibility, ElementName=TimelineHost}" Style="{StaticResource PanelBorder}" Padding="12,10">
                <Grid x:Name="TimelineHost" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="4,0"><TextBlock Text="用量趋势" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" /><TextBlock Text="Token / 时间" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Right" /></DockPanel>
                    <local:WpfTokenTimelineControl x:Name="Timeline" Grid.Row="1" />
                </Grid>
            </Border>
            <GridSplitter x:Name="TimelineSplitter" Grid.Row="1" Height="4" Margin="0,3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Visibility="Collapsed" />
            <Border x:Name="DetailsCard" Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12,10">
                <TabControl x:Name="DetailsTabs" Style="{StaticResource DetailsTabsStyle}" ItemContainerStyle="{StaticResource DetailsTabItemStyle}" SelectionChanged="DetailsTabs_SelectionChanged">
                    <TabItem x:Name="UsageAnalysisTab" Header="用量明细">
                        <Border x:Name="UsageBreakdownPanel" Background="Transparent" Padding="0" BorderThickness="0" Margin="0" TextElement.FontWeight="Normal">
                            <DataGrid x:Name="BreakdownGrid" FrozenColumnCount="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                        </Border>
                    </TabItem>
                    <TabItem x:Name="RealtimeDataTab" Header="实时数据">
                        <Border x:Name="RealtimeDataPanel" Background="Transparent" Padding="0" BorderThickness="0" Margin="0" TextElement.FontWeight="Normal"><ContentControl x:Name="RealtimeDataHost" /></Border>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Border x:Name="EmptyUsagePanel" Grid.Row="4" Grid.RowSpan="2" Style="{StaticResource PanelBorder}" Padding="28" Visibility="{Binding ShowEmpty, Converter={StaticResource UsageVisibility}}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                <Border Width="56" Height="56" Margin="0,0,0,10" HorizontalAlignment="Center" Background="{StaticResource AccentSoftBrush}" CornerRadius="16"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="EmptyUsageTitle" Text="{Binding Snapshot.EmptyTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="EmptyUsagePeriod" Text="{Binding Snapshot.EmptyPeriod}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyUsageHint" Text="{Binding Snapshot.EmptyHint}" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="7" Margin="2,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="AutoRefreshBox" Content="自动刷新" IsChecked="True" Checked="SpeedAutoRefresh_Changed" Unchecked="SpeedAutoRefresh_Changed" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="CopySummaryButton" Style="{StaticResource ToolButton}" Content="复制摘要" ToolTip="复制当前来源、时间范围、Token、费用与额度摘要" IsEnabled="{Binding CanCopy}" Click="CopySummaryButton_Click" />
            </StackPanel>
            <Button x:Name="CacheStatusButton" DockPanel.Dock="Right" Style="{StaticResource StatusLinkButton}" MaxWidth="220" Margin="0,0,12,0" Content="缓存详情" ToolTip="查看后台缓存进度与运行信息" Click="CacheStatusButton_Click">
                <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" /></DataTemplate></Button.ContentTemplate>
            </Button>
            <TextBlock x:Name="RealtimeSpeedText" DockPanel.Dock="Left" Text="实时并行速度 —" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="StatusText" Text="{Binding Status}" ToolTip="{Binding StatusDetail}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
        </DockPanel>
    </Grid>
</Window>
