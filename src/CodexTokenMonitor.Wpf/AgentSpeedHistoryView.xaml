<UserControl x:Class="CodexTokenMonitor.AgentSpeedHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Normal" UseLayoutRounding="True">
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="HistoryHeading" Margin="0,0,0,12">
            <TextBlock Text="速度历史" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="按日期、来源、模型与记录模式保存汇总 · 固定 UTC+8 · 原始日志删除后保留已入库历史" Style="{StaticResource SectionDescription}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="HistorySourceBox" Width="130" Margin="0,2,8,2" SelectionChanged="Query_Changed" />
                <DatePicker x:Name="StartDate" Width="135" Margin="0,2,8,2" SelectedDateChanged="Query_Changed" />
                <TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker x:Name="EndDate" Width="135" Margin="0,2,8,2" SelectedDateChanged="Query_Changed" />
                <Button x:Name="IndexButton" Content="更新历史索引" Click="Index_Click" Style="{StaticResource ToolButton}" Margin="0,2,8,2" />
                <Button x:Name="CancelIndexButton" Content="取消索引" Click="CancelIndex_Click" Style="{StaticResource ToolButton}" IsEnabled="False" Margin="0,2,8,2" />
                <Button x:Name="ExportButton" Content="导出 CSV" Click="Export_Click" Style="{StaticResource ToolButton}" IsEnabled="False" Margin="0,2,8,2" />
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="RangeSummary" Text="等待读取已保存的历史…" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="AverageSummary" Text="平均值只使用有最终用量与有效耗时的请求；每个来源的峰值仅在实时窗口观察后保存。" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="HistoryGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding Day}" Width="105" />
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="100" />
                <DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="记录模式" Binding="{Binding Mode}" Width="85" />
                <DataGridTextColumn Header="有效 / 请求" Binding="{Binding Coverage}" Width="110" />
                <DataGridTextColumn Header="输出 Token" Binding="{Binding Output}" Width="110" />
                <DataGridTextColumn Header="平均输出 tok/s" Binding="{Binding Average}" Width="115" />
                <DataGridTextColumn Header="平均总吞吐 tok/s" Binding="{Binding TotalAverage}" Width="125" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="HistoryStatus" Text="首次索引会读取完整本机日志，后台执行，可随时取消。" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="RepairButton" Grid.Column="1" Content="备份并重建" Click="Repair_Click" Style="{StaticResource ToolButton}" Margin="12,0,0,0" ToolTip="先保留当前历史库的备份，再从现有日志建立新库；已删除日志的旧统计可从备份恢复" />
        </Grid>
    </Grid>
</UserControl>
