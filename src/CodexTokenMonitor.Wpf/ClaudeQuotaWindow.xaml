<Window x:Class="CodexTokenMonitor.ClaudeQuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Claude 额度详情" Width="1160" Height="790" MinWidth="900" MinHeight="665"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="175" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Claude 额度详情" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="查看 5h / 7d 额度、Fable 重置卡和历史周用量。所有时间均为北京时间。" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="5h 满额 · 大致估算" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="FiveHourTotalValue" Text="待估算" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,2" />
                    <TextBlock x:Name="FiveHourTokensValue" Text="-- Token" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="FiveHourQuotaDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,6,0,3" />
                    <TextBlock x:Name="FiveHourSampleDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="7d 满额 · 大致估算" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="WeekTotalValue" Text="待估算" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,2" />
                    <TextBlock x:Name="WeekTokensValue" Text="-- Token" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="WeekQuotaDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,6,0,3" />
                    <TextBlock x:Name="WeekSampleDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14,9" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Fable 周额度与重置卡" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="FableQuotaText" Style="{StaticResource SectionDescription}" Margin="0,5,0,0" />
                <WrapPanel Margin="0,9,0,0">
                    <Label Content="剩余次数" Target="{Binding ElementName=FableResetCount}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <TextBox x:Name="FableResetCount" Width="56" MaxLength="5" Margin="0,0,14,0" VerticalContentAlignment="Center" />
                    <Label Content="到期时间（UTC+8）" Target="{Binding ElementName=FableResetExpiry}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <TextBox x:Name="FableResetExpiry" Width="158" MaxLength="16" Margin="0,0,12,0" VerticalContentAlignment="Center"
                             ToolTip="日期格式 yyyy-MM-dd HH:mm" />
                    <Button Content="保存本地记录" MinWidth="112" Click="SaveFableReset_Click" />
                </WrapPanel>
                <TextBlock x:Name="FableResetStatus" Style="{StaticResource SectionDescription}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource SectionDescription}" Margin="0,4,0,0"
                           Text="在 Claude 的「设置 → 使用情况」使用重置卡，再在这里更新剩余次数。重置会补满 Fable 额度及适用的 5h 额度，并返还 Fable 占用的周额度。" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12,9" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,7">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RefreshHistoryButton" Style="{StaticResource ToolButton}" Content="刷新历史" Click="RefreshHistory_Click" Margin="0,0,8,0" />
                        <Button x:Name="OpenCycleButton" Style="{StaticResource ToolButton}" Content="查看所选周期" IsEnabled="False" Click="OpenCycle_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="历史 7d 周期" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="CycleHistoryStatus" Text="等待读取本机历史…" Style="{StaticResource SectionDescription}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="CycleHistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column" FrozenColumnCount="1"
                          SelectionMode="Single" SelectionChanged="CycleHistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="周期（起止）" Binding="{Binding Period}" Width="218" />
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding UsageDetail}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="请求" Binding="{Binding Requests}" Width="65" ElementStyle="{StaticResource NumericCellText}" />
                        <DataGridTextColumn Header="本机 Token" Binding="{Binding Tokens}" Width="96" ElementStyle="{StaticResource NumericCellText}" />
                        <DataGridTextColumn Header="API 等价" Binding="{Binding Cost}" Width="94" ElementStyle="{StaticResource NumericCellText}" />
                        <DataGridTextColumn Header="7d 已用 / 剩余" Binding="{Binding WeekUsed}" Width="111" />
                        <DataGridTextColumn Header="Fable 已用" Binding="{Binding FableUsed}" Width="87" />
                        <DataGridTextColumn Header="官方读数时间" Binding="{Binding ObservedAt}" Width="118" />
                        <DataGridTextColumn Header="满额参考" Binding="{Binding FullReference}" Width="92" ElementStyle="{StaticResource NumericCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource DialogFooter}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionDescription}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="表中用量来自本机 Claude 模型日志，官方百分比以标注时间为准。满额参考只外推同一时间的用量和比例。" />
                <Button Grid.Column="1" Content="关闭" MinWidth="80" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
