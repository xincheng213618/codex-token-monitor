<Window x:Class="CodexTokenMonitor.ClaudeQuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Claude 满额参考" Width="860" Height="540" MinWidth="720" MinHeight="500"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Claude 满额参考" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="想知道自己的 5h、7d 大概能用多少？根据官方已用比例与本机已记录用量，自动外推 100% 的金额和 Token。" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="5h 满额 · 大致估算" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="FiveHourTotalValue" Text="待估算" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6" />
                    <TextBlock x:Name="FiveHourTokensValue" Text="-- Token" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="FiveHourQuotaDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,16,0,6" />
                    <TextBlock x:Name="FiveHourSampleDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="7d 满额 · 大致估算" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="WeekTotalValue" Text="待估算" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6" />
                    <TextBlock x:Name="WeekTokensValue" Text="-- Token" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="WeekQuotaDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,16,0,6" />
                    <TextBlock x:Name="WeekSampleDetail" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionDescription}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="金额为 API 等价参考，Token 含缓存输入。模型、缓存比例和缺失日志会影响外推；低比例样本只作大致参考。自动更新，无需手动录入。" />
                <Button Grid.Column="1" Content="关闭" MinWidth="80" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
