<Window x:Class="CodexTokenMonitor.GeminiQuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        x:ClassModifier="internal" Title="Gemini 额度估算与历史周期" Width="1360" Height="920" MinWidth="980" MinHeight="760"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="EstimateCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="EstimateDetail" TargetType="TextBlock" BasedOn="{StaticResource SectionDescription}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="EstimateValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,2,0,5" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="CycleActionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=CycleHistoryGrid}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumericColumn" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}" />
    </Window.Resources>
    <Grid Margin="20" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="174" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SyncDesktopButton" Style="{StaticResource PrimaryButton}" Content="同步桌面额度"
                            Margin="0,0,8,0" Click="SyncDesktop_Click"
                            ToolTip="读取 Antigravity 当前展开的 View Usage 或 Models 面板" />
                    <Button x:Name="CopyStatuslineConfigButton" Style="{StaticResource ToolButton}"
                            Content="复制 agy statusLine 配置" Click="CopyStatuslineConfig_Click"
                            ToolTip="复制 ~/.gemini/antigravity-cli/settings.json 的自动同步配置片段" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="额度估算 · Gemini" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="查看当前余量、费用折算与历史 7d 周期（支持中途提前重置保留、周期分档分析与费用曲线）。所有时间均为北京时间。" />
                </StackPanel>
            </DockPanel>
            <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" Visibility="Collapsed" IsIndeterminate="True"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.32*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource EstimateCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="5h 剩余额度" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="FiveHourSourceTag" Grid.Column="1" Style="{StaticResource EstimateDetail}" TextAlignment="Right" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="FiveHourTotalValue" Grid.Row="1" Text="未获取" Style="{StaticResource EstimateValue}" />
                    <TextBlock x:Name="FiveHourQuotaDetail" Grid.Row="2" Text="等待读取桌面额度、CLI 同步或手动登记" Style="{StaticResource EstimateDetail}" TextWrapping="Wrap" />
                    <TextBlock x:Name="FiveHourSampleDetail" Grid.Row="3" Style="{StaticResource EstimateDetail}" TextWrapping="NoWrap" Margin="0,6,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EstimateCard}" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="7d 剩余额度" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="WeekSourceTag" Grid.Column="1" Style="{StaticResource EstimateDetail}" TextAlignment="Right" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="WeekTotalValue" Grid.Row="1" Text="未获取" Style="{StaticResource EstimateValue}" />
                    <TextBlock x:Name="WeekQuotaDetail" Grid.Row="2" Text="等待读取桌面额度、CLI 同步或手动登记" Style="{StaticResource EstimateDetail}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WeekSampleDetail" Grid.Row="3" Style="{StaticResource EstimateDetail}" TextWrapping="NoWrap" Margin="0,6,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource EstimateCard}" Margin="8,0,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="登记当前额度读数" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SectionDescription}" Margin="0,2,0,7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="展开 Antigravity 模型菜单的 View Usage 后点右上角「同步桌面额度」可自动填入；也可在此直接登记剩余比例与重置时间。"
                               Text="展开 Antigravity 的 View Usage 可一键同步，或直接填写比例与倒计时（如 4d12h、14:30）：" />
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="5h" FontWeight="SemiBold" Width="26" VerticalAlignment="Center" />
                        <ComboBox x:Name="FiveHourModeBox" Width="76" Margin="0,0,6,0" SelectedIndex="0">
                            <ComboBoxItem Content="剩余 %" />
                            <ComboBoxItem Content="已用 %" />
                        </ComboBox>
                        <TextBox x:Name="FiveHourPercentBox" Width="54" MaxLength="6" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="0 - 100 百分比数值" />
                        <TextBlock Text="重置" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="FiveHourResetBox" Width="132" MaxLength="24" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="如 14:30、3h40m 或 2026-11-26 22:00" />
                        <Button Content="保存 5h" MinWidth="70" Click="SaveFiveHourReading_Click" />
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="7d" FontWeight="SemiBold" Width="26" VerticalAlignment="Center" />
                        <ComboBox x:Name="WeekModeBox" Width="76" Margin="0,0,6,0" SelectedIndex="0">
                            <ComboBoxItem Content="剩余 %" />
                            <ComboBoxItem Content="已用 %" />
                        </ComboBox>
                        <TextBox x:Name="WeekPercentBox" Width="54" MaxLength="6" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="0 - 100 百分比数值" />
                        <TextBlock Text="重置" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="WeekResetBox" Width="132" MaxLength="24" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="如 6d22h 或 2026-12-03 18:00" />
                        <Button Content="保存 7d" MinWidth="70" Click="SaveWeekReading_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="ReadingSaveStatus" Style="{StaticResource EstimateDetail}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource EstimateCard}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="手动估算 7d" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="剩余从" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <xctk:DecimalUpDown x:Name="ManualFromBox" Width="66" Height="32" Minimum="0" Maximum="100" Increment="1" Value="100" FormatString="F0" TextAlignment="Right" Margin="0,0,4,0" ShowButtonSpinner="False" />
                    <TextBlock Text="%  →" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <xctk:DecimalUpDown x:Name="ManualToBox" Width="66" Height="32" Minimum="0" Maximum="100" Increment="1" Value="73" FormatString="F0" TextAlignment="Right" Margin="0,0,4,0" ShowButtonSpinner="False" />
                    <TextBlock Text="%" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="ManualEstimateButton" Style="{StaticResource PrimaryButton}" Content="开始估算" Click="ManualEstimateButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="ManualResultText" Grid.Row="1" Text="输入前后剩余百分比（支持从周期起点 100% 或任意两次读数之间），折算当前周额度的满额规模。" Style="{StaticResource SectionDescription}" Margin="0,7,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="14,0,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="历史 7d 周期" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="HistoryCountText" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RefreshHistoryButton" Style="{StaticResource ToolButton}" Content="刷新历史" Margin="0,0,8,0" Click="RefreshHistory_Click" />
                        <Button x:Name="QuotaCurveButton" Style="{StaticResource ToolButton}" Content="打开额度曲线" Margin="0,0,8,0" Click="QuotaCurveButton_Click" />
                        <Button x:Name="AnalyzeCycleButton" Style="{StaticResource CycleActionButton}" Content="分析所选周期" Margin="0,0,8,0" Click="AnalyzeCycle_Click" />
                        <Button x:Name="OpenCycleButton" Style="{StaticResource CycleActionButton}" Content="主界面查看" Click="OpenCycle_Click" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="CycleHistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" FrozenColumnCount="1"
                          SelectionMode="Single" SelectionChanged="CycleHistoryGrid_SelectionChanged"
                          PreviewMouseRightButtonDown="CycleHistoryGrid_PreviewMouseRightButtonDown"
                          MouseDoubleClick="CycleHistoryGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="分析此周期的模型与额度代价" Click="AnalyzeCycle_Click" />
                            <MenuItem Header="在主界面按此周期查看明细" Click="OpenCycle_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="周期" Binding="{Binding Period}" Width="222">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding UsageDetail}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="历时" Binding="{Binding Duration}" Width="106" />
                        <DataGridTextColumn Header="重置" Binding="{Binding ResetAt}" Width="98" />
                        <DataGridTextColumn Header="读数" Binding="{Binding SnapshotCount}" Width="58" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="剩余" Binding="{Binding Remaining}" Width="64" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="已用" Binding="{Binding UsedPercent}" Width="62" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="应%" Binding="{Binding ExpectedPercent}" Width="60" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="节奏" Binding="{Binding Rhythm}" Width="124" />
                        <DataGridTextColumn Header="请求" Binding="{Binding Requests}" Width="68" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens}" Width="102" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="API 等价 $" Binding="{Binding Cost}" Width="112">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumn}">
                                    <Setter Property="ToolTip" Value="{Binding UsageDetail}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="满额折算 100% $" Binding="{Binding FullReference}" Width="128" ElementStyle="{StaticResource NumericColumn}" />
                        <DataGridTextColumn Header="最近读数" Binding="{Binding ObservedAt}" Width="128" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,38,16,10" TextBlock.TextAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=CycleHistoryGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="HistoryEmptyText" Text="正在读取历史周期…" Style="{StaticResource SectionDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource DialogFooter}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CycleHistoryStatus" Text="正在加载估算…" Style="{StaticResource SectionDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="关闭" MinWidth="80" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
